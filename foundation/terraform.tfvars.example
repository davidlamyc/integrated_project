# Copy this file to terraform.tfvars and fill in your values

resource_group_name = "rg-hubspoke-network"
location           = "eastus"

# Admin credentials for test VMs
admin_username = "azureadmin"
admin_password = "ChangeMe123!@#"  # Use a strong password

# Your public IP address for Bastion access
# Find your IP at: https://whatismyipaddress.com
allowed_source_ip = "0.0.0.0/0"  # Replace with your actual IP (e.g., "203.0.113.1/32")

# VM size
vm_size = "Standard_B2s"
